FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_ADMIN_API_URL
ENV VITE_ADMIN_API_URL=${VITE_ADMIN_API_URL}

ARG VITE_RAG_API_URL
ENV VITE_RAG_API_URL=${VITE_RAG_API_URL}

ARG VITE_TENANT_NAME
ENV VITE_TENANT_NAME=${VITE_TENANT_NAME}

ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}

ARG VITE_CHAT_WIDGET_URL
ENV VITE_CHAT_WIDGET_URL=${VITE_CHAT_WIDGET_URL}

ARG VITE_ADMIN_FRONTEND_URL
ENV VITE_ADMIN_FRONTEND_URL=${VITE_ADMIN_FRONTEND_URL}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# 只有 provider=local（或線上金鑰都沒設定時的當日摘要 fallback）才會用到本地模型，
# 需要另外安裝 requirements-local-llm.txt。
# 固定使用 openbmb/MiniCPM5-2B（CPU 執行，速度較慢，不需要 bitsandbytes；
# 這顆模型在 Apple Silicon 的 MPS 上會直接當機，app/llm.py 已刻意跳過 MPS 強制用 CPU；
# 混合推理模型，預設用 enable_thinking=False 關掉思考過程，輸出仍常是簡體字，
# app/llm.py 的 generate() 會自動做簡轉繁）

# 前端網址，用於 CORS 設定，多個網址用逗號分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# RAG 檢索引擎固定用 llamaindex（LlamaIndex VectorStoreIndex + pgvector，本地 embedding），
# 需要另外安裝 requirements-local-llm.txt，見 backend/README.md「RAG 引擎」一節。

# llamaindex 引擎的 pgvector（PostgreSQL）連線設定。統一指向 Supabase 專案的 Transaction
# pooler（本機開發與 Cloud Run 正式環境共用同一個資料庫，不再各自起一個 pgvector），
# 見 backend/README.md「pgvector（Supabase）」一節。RAG_PG_PASSWORD 是專案建立時設定的
# 資料庫密碼，請自行填入，不要外流／提交進版控。
RAG_PG_HOST=aws-0-ap-northeast-2.pooler.supabase.com
RAG_PG_PORT=6543
RAG_PG_DATABASE=postgres
RAG_PG_USER=postgres.zsshivonwqppffcanujj
RAG_PG_PASSWORD=
RAG_PG_TABLE=kb_chunks

# RAG 重排序（Qwen3-Reranker-0.6B ONNX INT8，選用，預設關閉）。這是「這台伺服器允許使用 rerank」
# 的總開關；每家公司要不要用，還要在後台「Chatbot 設定」頁勾選。見 backend/README.md「RAG 重排序」。
# 正式環境（Cloud Run）不啟用，程式會強制停用，就算這裡設成 true 也一樣，請不要設定。
# RERANK_ENABLED=true
# 開啟 rerank 時向量檢索撈幾筆候選：每筆約 0.25 秒（本機 Apple Silicon），50 筆約 12 秒，20 筆約 5 秒（預設 20）
# RERANK_CANDIDATES=20
# 每次檢索送給 LLM 的片段數 k 的系統預設值（每家公司可在後台調整，1～10）
# RAG_DEFAULT_TOP_K=5

# 多租戶帳號（Google 登入）：前端拿到的 Google ID token 要用這個 OAuth Client ID 驗證
# 簽發對象，跟 admin-frontend 的 VITE_GOOGLE_CLIENT_ID 要填同一組值，見
# backend/README.md 或專案計畫文件裡的 Google Cloud Console 設定步驟。
GOOGLE_CLIENT_ID=

# 登入 session 有效期限（小時），過期後要重新登入。
SESSION_TTL_HOURS=24

# 服務啟動時，若 accounts 表是空的（全新資料庫，還沒有人能登入），把這裡列出的 email
# （逗號分隔）建成 platform_primary 帳號，解決「雞生蛋」的 bootstrap 問題；建立後可留空。
INITIAL_PLATFORM_ADMIN_EMAILS=

# 開發用「一鍵登入」（登入頁 Google 按鈕右邊的「開發測試登入」），預設關閉。
# 警告：本機使用的資料庫若與正式環境相同，開啟後登入會在該資料庫建立／使用一個 platform 管理員帳號。
# 只接受本機請求；在 Cloud Run 上即使設成 true 也一律停用；只會自動建立保留網域
# （.invalid／.local／.test／.localhost）的帳號，不會替真實 email 建立管理員。
# 前端另外要在 admin-frontend/.env.local 設定 VITE_DEV_LOGIN=true（只有 npm run dev 才會顯示按鈕）。
# DEV_LOGIN_ENABLED=true
# DEV_LOGIN_EMAIL=dev-admin@local.invalid

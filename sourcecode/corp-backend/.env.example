# Corp Backend Environment Configuration

# 服務埠號
PORT=8001

# API 路由前綴
API_V1_STR=/api/v1

# GCP / Firebase 專案設定
GCP_PROJECT_ID=your-gcp-project-id

# Firebase 憑證路徑 (任選一種方式設定)
# 方式 1: 服務帳戶 JSON 檔案絕對或相對路徑
FIREBASE_CREDENTIALS_PATH=

# 方式 2: 服務帳戶 JSON 字串內容 (多用於 CI/CD 或容器環境變數)
FIREBASE_CREDENTIALS_JSON=

# Firestore Emulator 主機位址 (選填，開發測試用，例如: 127.0.0.1:8080)
# FIRESTORE_EMULATOR_HOST=

# MCP endpoint 的 Bearer 金鑰（請各自產生足夠長的隨機字串，兩把不要相同）
# /mcp：唯讀 tools，聊天後端使用；/mcp-admin：列表與寫入 tools，聊天後端不使用。
# 任何一把沒設定時，對應的 endpoint 會拒絕所有請求（HTTP 503）。
MCP_API_KEY=
MCP_ADMIN_API_KEY=

# MCP 的 Host header 檢查（選填）。預設只放行 localhost；在 Cloud Run 上（有 K_SERVICE）沒設定時會自動停用，
# 改由 Bearer 金鑰把關。想限制只接受特定網域時填（逗號分隔），例如：
# MCP_ALLOWED_HOSTS=crm-squard-stage-corp-backend-821217334800.europe-west1.run.app

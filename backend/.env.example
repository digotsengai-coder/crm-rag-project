# true = 使用 Qwen2.5-1.5B-Instruct（CPU也可跑，速度較慢，不需要 bitsandbytes）
# false = 使用 Qwen2.5-7B-Instruct 4-bit 量化（需要 GPU，建議 VRAM 12GB 以上）
USE_SMALL_MODEL=false

# 前端網址，用於 CORS 設定，多個網址用逗號分隔
CORS_ORIGINS=http://localhost:5173

# RAG 檢索引擎：custom（自訂 Chroma + 手寫檢索，預設）或 llamaindex（用 LlamaIndex 的 VectorStoreIndex）
# 兩套引擎功能等價、可隨時切換，見 backend/README.md「RAG 引擎切換」一節
RAG_ENGINE=custom
